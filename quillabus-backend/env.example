# Copia este archivo como .env y ajusta los valores.
# Local:
DATABASE_URL=postgres://postgres@127.0.0.1:5432/quillabus
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
PORT=3000
NODE_ENV=development
# CORS solo es necesario si abres la app desde otro origen. Servida por este backend, déjalo vacío.
CORS_ORIGIN=
# Clave inicial de los tres usuarios demo. En producción usa un valor seguro.
DEMO_PASSWORD=Quilla2026!

# Producción (Render/Railway): la base gestionada inyecta DATABASE_URL.
# Define JWT_SECRET con un valor largo, NODE_ENV=production y DEMO_PASSWORD antes del primer setup.
# Si el proveedor exige SSL, agrega ?sslmode=require al final de DATABASE_URL.

# Opcional: notificaciones push con Firebase.
# En local puedes usar la ruta al JSON de la cuenta de servicio:
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-credenciales.json
# En Render/Railway pega el JSON completo como variable de entorno:
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
